{
  "name": "demo-agentes/task-api",
  "description": "API de tareas de DemoAgentes",
  "type": "project",
  "version": "0.1.0",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*",
    "doctrine/orm": "^3.5",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*"
  },
  "autoload": {"psr-4": {"App\\": "src/", "DoctrineMigrations\\": "migrations/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {"allow-plugins": {"symfony/runtime": true}, "sort-packages": true},
  "scripts": {
    "test": "php vendor/phpunit/phpunit/phpunit",
    "analyse": "php vendor/phpstan/phpstan/phpstan analyse --memory-limit=512M",
    "migrate": "php bin/console doctrine:migrations:migrate --no-interaction"
  }
}
